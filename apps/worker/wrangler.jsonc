{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "haven-agent",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "haven",
      // Created 2026-11-26 in the owner's Cloudflare account. Local dev and tests use a local copy.
      "database_id": "1de208c4-4bb5-4ff3-839a-246799e48e83",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": { "crons": ["17 * * * *"] },
  // Production LLM (DECISIONS.md D11). The key is the secret DEEPSEEK_API_KEY. `.dev.vars` overrides this locally; tests force "none".
  "vars": { "LLM_PROVIDER": "deepseek" },
  // One URL for everything (DECISIONS.md D2): the worker answers /api/*, Cloudflare serves the web build for the rest.
  // Build it first: `npm run build -w @haven/web` (the root `npm run deploy` does both).
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
  // Secrets: ANTHROPIC_API_KEY and DEMO_COUNSELLOR_PASSCODE, `.dev.vars` locally, `wrangler secret put` when deployed.
}
