{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "haven-agent",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "haven",
      // Replace with the real id after `wrangler d1 create haven` (deployment step). Local dev and tests ignore it.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": { "crons": ["17 * * * *"] }
  // Secrets: ANTHROPIC_API_KEY and DEMO_COUNSELLOR_PASSCODE, `.dev.vars` locally, `wrangler secret put` when deployed.
}
